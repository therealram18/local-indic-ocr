{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huggingface.co/bodhan-ai/indic-doc-parser/raw/main/schemas/ocr_request.schema.json",
  "title": "IndicBlockOCR request (one block crop, served)",
  "description": "The OpenAI chat-completions body for ONE crop, as built by serving.recognizer_http.build_messages. This is the only JSON the recognizer sees; the model itself takes an image plus a prompt string, and returns plain text, not JSON. The endpoint serves the recognizer alone and expects one block crop per request -- it is not a page-level API. Image part first, then text: the chat template branches on content order, and reversing it changes the rendered prompt.",
  "type": "object",
  "required": [
    "model",
    "messages"
  ],
  "properties": {
    "model": {
      "type": "string",
      "default": "IndicBlockOCR"
    },
    "temperature": {
      "type": "number",
      "default": 0.0,
      "description": "0.0 (greedy) is the only setting reproducible run to run."
    },
    "max_tokens": {
      "type": "integer",
      "default": 2048
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "const": "user"
          },
          "content": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "object",
                "required": [
                  "type",
                  "image_url"
                ],
                "properties": {
                  "type": {
                    "const": "image_url"
                  },
                  "image_url": {
                    "type": "object",
                    "required": [
                      "url"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "pattern": "^data:image/",
                        "description": "The crop as a PNG data URI. The crop is area-clamped to [256^2, 1536^2] px before encoding -- see idp_crops.area_clamp."
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "text"
                ],
                "properties": {
                  "type": {
                    "const": "text"
                  },
                  "text": {
                    "type": "string",
                    "description": "The prompt for this block's type, from contract.prompt_for(): transcription, LaTeX-only, or table-to-HTML."
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
