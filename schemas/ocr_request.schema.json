{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huggingface.co/bodhan-ai/indic-doc-parser/raw/main/schemas/ocr_request.schema.json",
  "title": "Recognizer request, one block crop (served path only)",
  "description": "OpenAI chat-completions body for ONE crop. The model takes an image and a prompt and returns plain text, so there is no response schema. Offline use sends no JSON at all. Image part first, then text: the chat template branches on content order.",
  "type": "object",
  "required": [
    "model",
    "messages"
  ],
  "properties": {
    "model": {
      "type": "string",
      "default": "IndicBlockOCR"
    },
    "temperature": {
      "type": "number",
      "default": 0.0
    },
    "max_tokens": {
      "type": "integer",
      "default": 2048
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "const": "user"
          },
          "content": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "object",
                "required": [
                  "type",
                  "image_url"
                ],
                "properties": {
                  "type": {
                    "const": "image_url"
                  },
                  "image_url": {
                    "type": "object",
                    "required": [
                      "url"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "pattern": "^data:image/",
                        "description": "The crop as a PNG data URI, area-clamped to [256^2, 1536^2] px."
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "text"
                ],
                "properties": {
                  "type": {
                    "const": "text"
                  },
                  "text": {
                    "type": "string",
                    "description": "The prompt for this block's type."
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
